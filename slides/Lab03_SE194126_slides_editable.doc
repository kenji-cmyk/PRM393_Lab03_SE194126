          </div>
          <div class="img-frame">
            <img src="../evidence/cloud/screenshots/07-auth-account-switch-clean.png" alt="Chuyển tài khoản">
            <div class="caption">Chuyển tài khoản sạch phiên</div>
          </div>
        </div>
      </div>
