# Optional model override; the Gemini API key belongs in Secret Manager.
GEMINI_MODEL=gemini-3.8-flash

# Cloudinary report uploads.
# - Production deploy: copy into ignored functions/.env.<project-id> (e.g. functions/.env.vetalife-24f03)
# - Local emulators: copy non-secret keys into ignored functions/.env.local and put
#   CLOUDINARY_API_SECRET=... in ignored functions/.secret.local
# Keep CLOUDINARY_API_SECRET in Secret Manager for production; never commit real values.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_REPORT_UPLOAD_PRESET=
