# Optional model override; the Gemini API key belongs in Secret Manager.
GEMINI_MODEL=gemini-3.8-flash

# Cloudinary report uploads. Set these in the Firebase Functions environment.
# Keep CLOUDINARY_API_SECRET in Secret Manager; never put it in this file.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_REPORT_UPLOAD_PRESET=
